#!/bin/bash
# Compiles java/ into lib/node-jdbc.jar. Targets Java 8 bytecode so the jar loads on every
# JVM the package supports, whichever JDK builds it.
set -euo pipefail

cd "$(dirname "$0")/.."

out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT

javac -source 8 -target 8 -Xlint:-options -d "$out" $(find java -name '*.java')
jar cf lib/node-jdbc.jar -C "$out" .
